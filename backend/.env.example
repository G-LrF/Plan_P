# ==========================================================================
# .env.example —— 配置模板（这个文件【要】提交到 Git）
# ==========================================================================
# 【它的作用】
#   告诉别人"这个项目需要配哪些环境变量"，但不泄露真实值。
#   别人 clone 项目后执行：  copy .env.example .env
#   然后把里面的占位符换成自己的值。
#
# 【为什么必须有这个文件】
#   如果只有 .gitignore 里的 .env 被排除，新同事拿到项目会完全不知道
#   需要配什么，程序一起来就报"找不到 DATABASE_URL"。
#   模板文件解决了"我知道缺东西但不知道缺什么"的问题。
# ==========================================================================

# 数据库连接串
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# ⚠️ 密码含 @ # % / : 等符号时必须 URL 编码（@ → %40）
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/plan_app?charset=utf8mb4

# 应用名称
APP_NAME=Plan Training API

# 应用版本
APP_VERSION=0.4.0

# 调试模式（生产环境必须设为 false）
DEBUG=true

# 允许跨域的前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
